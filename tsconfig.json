{
  // This project ships plain JavaScript (a Node relay plus a single self-contained
  // HTML/Three.js client). `tsc -b --noEmit` is the typecheck the CI workflow and
  // the local check scripts run; this config lets it surface JS *syntax* errors
  // while leaving full semantic checking off, because the client is authored in JS.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.js", "tools/**/*.mjs"]
}
