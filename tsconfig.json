{
  // This project ships plain JavaScript (a Node relay plus a single self-contained
  // HTML/Three.js client), but Freebuff's post-turn gate runs `tsc -b --noEmit`.
  // This config satisfies that gate and still surfaces JS *syntax* errors, while
  // leaving full semantic checking off because the client is authored in JS.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.js", "tools/**/*.mjs"]
}
